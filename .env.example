# ── Postgres ──────────────────────────────────────
POSTGRES_USER=vplmqa
POSTGRES_PASSWORD=change_me_in_prod

# ── Redis ─────────────────────────────────────────
REDIS_PASSWORD=change_me_in_prod

# ── JWT ───────────────────────────────────────────
# 64-char minimum. Loaded from Vault in prod — set here for local dev only.
JWT_SECRET=your-256-bit-secret-here-minimum-64-characters-required-for-HS512

# ── Kafka ─────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── MinIO ─────────────────────────────────────────
MINIO_ROOT_USER=vplmqa
MINIO_ROOT_PASSWORD=change_me_in_prod
MINIO_ENDPOINT=http://minio:9000

# ── Ollama ────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434

# ── Azure OpenAI (vision only) ────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ── HashiCorp Vault ───────────────────────────────
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=dev-root-token   # replace with AppRole in prod

# ── Mail (notification-service) ───────────────────
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=noreply@yourapp.com
MAIL_PASSWORD=your-smtp-password

# ── Figma (per-project, stored encrypted in project_db) ───
# Do not put Figma tokens here — they are stored per-project in project-service
# and encrypted via Vault transit engine.

# Gemini / Google GenAI for LangGraph E2E agents
# Keep real keys only in .env or Docker/CI secrets, never in source.
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TEMPERATURE=0.2
GEMINI_MIN_CALL_INTERVAL_SECONDS=1
